# Django Core Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-for-maximum-security
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://u2-backend.vercel.app,http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO

# Supabase PostgreSQL Database Credentials
host=aws-0-us-east-1.pooler.supabase.com
port=5432
database=postgres
user=postgres.your-project-ref
password=your-database-password

# CORS Settings (URLs permitidas para el cliente web SPA)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5500,https://u2-backend.vercel.app